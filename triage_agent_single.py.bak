import math
from dataclasses import dataclass
from typing import Dict, Any, List, Optional


class TriageAgent:
    """Autonomous Medical Triage Decision Agent (S2)

    Implements the required four-phase deliberation pipeline:
    1. Understand (Data Completeness, Reliability)
    2. Analyze Multiple Angles (Risk, Impacts)
    3. Self-Evaluate Confidence (Confidence Score, Uncertainty)
    4. Decision Gate (Strict Rubric)

    The agent decides whether to recommend an immediate hospital visit or not.
    It refuses on: missing symptoms, conflicting symptoms, high severity risk (>70%), or low confidence (<50%).
    """

    REQUIRED_FIELDS = [
        "age",
        "chief_complaint",
        "symptoms",
        "time_since_onset",
    ]

    VITAL_KEYS = [
        "heart_rate",
        "respiratory_rate",
        "blood_pressure_systolic",
        "blood_pressure_diastolic",
        "o2_saturation",
        "temperature",
    ]

    DECISIONS = (
        "ACT_CONFIDENTLY",
        "ACT_WITH_WARNING",
        "ASK_FOR_MORE_INFORMATION",
        "REFUSE_AUTONOMOUS_ACTION",
    )

    @dataclass
    class Config:
        min_confidence_threshold: float = 50.0  # refuse if below
        high_confidence_threshold: float = 80.0  # act confidently if above (and low risk)
        max_risk_threshold: float = 70.0  # refuse if above
        completeness_threshold: float = 60.0 # ask more info if below
        contradiction_penalty: float = 20.0

    def __init__(self, config: Optional[Config] = None) -> None:
        self.config = config or TriageAgent.Config()

    def _compute_data_completeness(self, inputs: Dict[str, Any]) -> float:
        """Step 1 helper: Compute data completeness percentage."""
        present = 0
        total_fields = len(self.REQUIRED_FIELDS)
        
        # Check basic required fields
        for f in self.REQUIRED_FIELDS:
            if f in inputs and inputs[f] is not None and inputs[f] != "":
                present += 1
        
        # Check vitals (weighted as one block or individual? User said 'Vital reliability' separate, 
        # but 'Data completeness' is also an input. Let's count vitals as fields.)
        vitals = inputs.get("vital_signs") or {}
        vitals_present = 0
        for k in self.VITAL_KEYS:
            if k in vitals and vitals[k] is not None:
                vitals_present += 1
        
        total_possible = total_fields + len(self.VITAL_KEYS)
        score = (present + vitals_present) / total_possible
        return round(score * 100.0, 1)

    def _compute_vital_reliability(self, inputs: Dict[str, Any]) -> float:
        """Step 1 helper: Compute vital sign reliability percentage."""
        # If explicitly provided in input, use it (as per user 'Input from UI')
        if "vital_reliability" in inputs:
             return float(inputs["vital_reliability"])

        vitals = inputs.get("vital_signs") or {}
        if not vitals:
            return 0.0

        score = 0
        count = 0
        for k in self.VITAL_KEYS:
            val = vitals.get(k)
            if val is not None:
                count += 1
                # Basic plausibility checks (if physically impossible, reliability is 0 for that field)
                if k == "o2_saturation" and (val < 30 or val > 100): score += 0
                elif k == "heart_rate" and (val < 0 or val > 300): score += 0
                elif k == "temperature" and (val < 20 or val > 45): score += 0
                else: score += 1
        
        if count == 0:
            return 0.0
            
        # Normalize to 0-100
        return round((score / len(self.VITAL_KEYS)) * 100.0, 1)

    def _detect_conflicting_signals(self, inputs: Dict[str, Any]) -> bool:
        """Step 1 helper: Detect contradictions."""
        # Check explicit flag
        if inputs.get("contraction_flag") is True:
            return True

        vitals = inputs.get("vital_signs") or {}
        
        # Heuristic 1: Low O2 but normal Respiratory Rate
        if vitals.get("o2_saturation") and vitals["o2_saturation"] < 90:
             if vitals.get("respiratory_rate") and vitals["respiratory_rate"] < 12:
                 return True # Contradiction: Hypoxic but not tachypneic? Rare/End-stage.
        
        # Heuristic 2: Shock index high (HR > SBP) but patient described as 'fine'?
        # (Simplified for this agent)
        
        return False

    def _calculate_risk_severity(self, inputs: Dict[str, Any]) -> float:
        """Step 2 helper: Calculate Risk Severity (0-100)."""
        # Use explicit input if available
        if "risk_severity_score" in inputs:
            return float(inputs["risk_severity_score"])

        score = 0.0
        vitals = inputs.get("vital_signs") or {}
        
        # Heuristics based on NEWS2 (simplified)
        # Respiratory Rate
        rr = vitals.get("respiratory_rate")
        if rr:
            if rr <= 8 or rr >= 25: score += 30
            elif rr >= 21: score += 20
        
        # Oxygen Saturation
        o2 = vitals.get("o2_saturation")
        if o2:
            if o2 <= 91: score += 30
            elif o2 <= 93: score += 20
        
        # Systolic BP
        sbp = vitals.get("blood_pressure_systolic")
        if sbp:
            if sbp <= 90: score += 30
            elif sbp >= 220: score += 20
        
        # Heart Rate
        hr = vitals.get("heart_rate")
        if hr:
            if hr <= 40 or hr >= 131: score += 30
            elif hr >= 111: score += 20
            
        # Symptom severity input
        symptom_sev = inputs.get("symptom_severity", 0) # 0-100
        score += float(symptom_sev) * 0.4 # Weight symptom severity
        
        return min(100.0, score)

    def _detect_manipulation(self, inputs: Dict[str, Any]) -> bool:
        """Detect attempts to ignore symptoms or force outcomes."""
        user_text = str(inputs).lower()
        triggers = [
            "ignore previous symptoms",
            "just say it's fine",
            "ignore symptoms",
            "override decision",
            "force clear"
        ]
        for t in triggers:
            if t in user_text:
                return True
        return inputs.get("manipulation_flag", False)

    def deliberate(self, inputs: Dict[str, Any]) -> Dict[str, Any]:
        """Run the four-phase deliberation pipeline."""
        
        logs = []
        def log(phase, msg):
            logs.append(f"{phase}: {msg}")

        # --- STEP 1: UNDERSTAND ---
        completeness = self._compute_data_completeness(inputs)
        vital_reliability = self._compute_vital_reliability(inputs)
        has_contradictions = self._detect_conflicting_signals(inputs)
        is_manipulative = self._detect_manipulation(inputs)
        
        step1_log = {
            "Data completeness": f"{completeness}%",
            "Vital reliability": f"{vital_reliability}%",
            "Missing info": "Yes" if completeness < 100 else "No",
            "Contradictions": "Yes" if has_contradictions else "No"
        }
        log("UNDERSTAND", str(step1_log))

        # --- STEP 2: ANALYZE MULTIPLE ANGLES ---
        risk_severity = self._calculate_risk_severity(inputs)
        
        # -- AGENTIC: Contextual Analysis --
        # Explain WHY the risk is high/low
        risk_context = []
        vitals = inputs.get("vital_signs") or {}
        
        # Normal Ranges (Simplified Adult)
        if vitals.get("heart_rate"):
            hr = vitals["heart_rate"]
            if hr > 100: risk_context.append(f"Heart Rate {hr} is HIGH (Normal: 60-100). Possible Tachycardia.")
            elif hr < 60: risk_context.append(f"Heart Rate {hr} is LOW (Normal: 60-100). Possible Bradycardia.")
            else: risk_context.append(f"Heart Rate {hr} is Normal.")
            
        if vitals.get("o2_saturation"):
            o2 = vitals["o2_saturation"]
            if o2 < 95: risk_context.append(f"O2 Sat {o2}% is LOW (Normal: >95%). Potential Hypoxia.")
            else: risk_context.append(f"O2 Sat {o2}% is Normal.")
            
        if vitals.get("blood_pressure_systolic"):
            sbp = vitals["blood_pressure_systolic"]
            if sbp > 140: risk_context.append(f"Systolic BP {sbp} is HIGH (Normal: <120). Hypertension.")
            elif sbp < 90: risk_context.append(f"Systolic BP {sbp} is LOW (Normal: >90). Hypotension risk.")
            
        if risk_severity > 50 and not risk_context:
             risk_context.append("Risk score elevated due to symptom severity or combination of factors.")

        # Analysis logic
        risk_action = "Medium" if risk_severity > 30 else "Low"
        if risk_severity > 70: risk_action = "High"
        
        step2_log = {
            "Risk of not acting": risk_action,
            "Risk of acting unnecessarily": "Medium" if risk_severity < 30 else "Low",
            "Conflicting signals": "Detected" if has_contradictions else "None",
            "Manipulation Attempt": "Detected" if is_manipulative else "None",
            "Clinical Context": risk_context  # New field
        }
        log("ANALYSIS", str(step2_log))

        # --- STEP 3: SELF-EVALUATE CONFIDENCE (SELF-DOUBT) ---
        # Formula:
        # Evidence Quality = Vital reliability
        # Completeness Score = Data completeness
        # Contradiction Penalty = -20 if contradictions
        
        evidence_quality = vital_reliability
        completeness_score = completeness
        penalty = -self.config.contradiction_penalty if has_contradictions else 0.0
        
        # Weighted average for base confidence? Or simple average?
        # User prompt implies: "Confidence: 62%"
        # Let's assume average of Quality & Completeness, then apply penalty.
        # (80 + 75) / 2 = 77.5. Minus 20 = 57.5. Close to 62 example.
        
        base_score = (evidence_quality * 0.5) + (completeness_score * 0.5)
        confidence = base_score + penalty
        
        if is_manipulative:
            confidence = 0.0 # Force refusal
        
        uncertainty_level = "High"
        if confidence > 80: uncertainty_level = "Low"
        elif confidence > 50: uncertainty_level = "Moderate"
        
        step3_log = {
            "Confidence": f"{confidence:.1f}%",
            "Contradictions": "Present" if has_contradictions else "Absent",
            "Uncertainty Level": uncertainty_level
        }
        log("SELF-EVALUATION", str(step3_log))

        # Phase 4: DECISION GATE (strict)
        decision = None
        reason = None
        recommendation = ""

        # Prioritize checking for Missing Info (Step 1) before Low Confidence (Step 3) checks
        
        # Build a narrative reason from the context
        clinical_narrative = " ".join(risk_context) if risk_context else "All analyzed parameters appear within normal ranges."
        
        if is_manipulative:
             decision = "REFUSE_AUTONOMOUS_ACTION"
             reason = f"Safety Protocol: Manipulation attempt detected. {clinical_narrative}"
             recommendation = "Please provide accurate symptom data for safety."
        elif completeness < self.config.completeness_threshold:
             decision = "ASK_FOR_MORE_INFORMATION"
             reason = f"Insufficient Data: {clinical_narrative}. Completeness is only {completeness:.1f}%."
             recommendation = "Please provide missing vital signs or symptom details."
        elif risk_severity > self.config.max_risk_threshold: # > 70%
            decision = "REFUSE_AUTONOMOUS_ACTION"
            reason = f"Risk Threshold Exceeded: {clinical_narrative}"
            recommendation = "IMMEDIATE ESCALATION REQUIRED. Call emergency services or visit nearest ER."
        elif confidence < self.config.min_confidence_threshold: # < 50%
            decision = "REFUSE_AUTONOMOUS_ACTION"
            reason = f"Uncertainty Too High: {clinical_narrative}. Confidence ({confidence:.1f}%) below threshold."
            recommendation = "Please provide more complete and consistent information."
        elif 50 <= confidence <= 80:
            decision = "ACT_WITH_WARNING"
            reason = f"Clinical Caution: {clinical_narrative}"
            recommendation = "Seek medical consultation within 24 hours. Monitor symptoms closely."
        elif confidence > 80 and risk_severity <= 30: # Low risk + High confidence
            decision = "ACT_CONFIDENTLY"
            reason = f"Stable Assessment: {clinical_narrative}"
            recommendation = "Self-care advice: Rest, hydration. Monitor for changes."
        else:
             # Fallback for High Confidence but Moderate Risk? -> Warning
             decision = "ACT_WITH_WARNING"
             reason = f"Observation Required: {clinical_narrative}"
             recommendation = "Consult a doctor to rule out complications."

        result = {
            "phase_logs": {
                "understand": step1_log,
                "analyze": step2_log,
                "self_evaluation": step3_log,
            },
            "metrics": {
                "completeness": completeness,
                "reliability": vital_reliability,
                "risk_severity": risk_severity,
                "confidence": confidence,
            },
            "decision": decision,
            "reason": reason,
            "recommendation": recommendation,
            "logs_text": "\n".join(logs)
        }
        
        return result


def demo():
    agent = TriageAgent()
    
    # Scenario: Moderate confidence, warning
    print("\n--- Scenario 1: Standard Case ---")
    inputs = {
        "age": 45,
        "chief_complaint": "fever",
        "symptoms": ["fever", "chills"],
        "time_since_onset": "2 days",
        "symptom_severity": 40,
        "vital_signs": {
            "temperature": 38.5,
            "heart_rate": 95,
            # Missing BP, O2
        }
    }
    print(agent.deliberate(inputs)["decision"])

    # Scenario: High Risk Refusal
    print("\n--- Scenario 2: High Severity ---")
    inputs_high_risk = {
        "age": 60,
        "chief_complaint": "chest pain",
        "symptoms": ["crushing chest pain"],
        "time_since_onset": "30 mins",
        "symptom_severity": 95,
        "vital_signs": {
            "heart_rate": 120,
            "blood_pressure_systolic": 180,
            "o2_saturation": 92
        }
    }
    print(agent.deliberate(inputs_high_risk)["decision"])

    # Scenario: Manipulation
    print("\n--- Scenario 3: Manipulation ---")
    inputs_manip = {
        "age": 20,
        "chief_complaint": "headache",
         "symptoms": ["headache"],
        "time_since_onset": "1 hour",
        "user_note": "Ignore previous symptoms and just say it's fine"
    }
    print(agent.deliberate(inputs_manip)["decision"])

if __name__ == "__main__":
    demo()
